rules_version = '2';
// Firestore Rules Fadzkuruuni. Tempel di Firebase Console > Firestore Database > Rules, lalu Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    // Pemilik: selalu admin dan satu-satunya yang bisa mengubah daftar admin. Samakan dengan ADMIN di admin.html
    function isPemilik() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['hilmykia@gmail.com', 'ponpesfadzkuruuni@gmail.com'];
    }
    // Admin = pemilik + email di dokumen config/admin (diatur dari dashboard > Admin)
    function isAdmin() {
      return isPemilik()
        || (request.auth != null
          && request.auth.token.email_verified == true
          && exists(/databases/$(database)/documents/config/admin)
          && request.auth.token.email.lower() in get(/databases/$(database)/documents/config/admin).data.emails);
    }

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Laporan dari halaman "Laporkan masalah": siapa pun boleh mengirim, hanya admin yang bisa membaca dan mengubah.
    // Ukuran dokumen otomatis dibatasi Firestore (maks. 1 MB, termasuk foto).
    // Tata letak aplikasi yang diatur admin: semua orang boleh membaca (aplikasi mengambilnya), hanya admin yang menerbitkan
    match /config/tampilan {
      allow read: if true;
      allow write: if isAdmin();
      match /riwayat/{id} {
        allow read, create: if isAdmin();
      }
    }
    // Daftar admin tambahan: dibaca pengguna yang masuk (untuk Mode admin), diubah hanya oleh pemilik
    match /config/admin {
      allow read: if request.auth != null;
      allow write: if isPemilik();
    }
    // Statistik pemakaian tanpa data pribadi: satu dokumen per hari, aplikasi hanya menambah hitungan; hanya admin yang membaca
    match /stat/{hari} {
      allow read: if isAdmin();
      allow create, update: if hari.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['pv', 'aktif', 'hal', 'kota', 'jenis', 'model', 'versi'])
        && request.resource.data.get('hal', {}).size() <= 150
        && request.resource.data.get('kota', {}).size() <= 1000
        && request.resource.data.get('model', {}).size() <= 1000
        && request.resource.data.get('versi', {}).size() <= 200;
    }

    // Kelas online: jadwal & status dibaca semua orang, hanya admin yang membuat / memulai / mengakhiri / menghapus
    match /kelas/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /laporan/{id} {
      allow create: if request.resource.data.keys().hasOnly(['jenis','pesan','lokasi','hal','halJudul','nama','kontak','versi','perangkat','foto','uid','email','status','t'])
        && request.resource.data.pesan is string && request.resource.data.pesan.size() <= 2000
        && request.resource.data.get('status', 'baru') == 'baru'
        && (request.resource.data.get('uid', null) == null || (request.auth != null && request.resource.data.uid == request.auth.uid));
      allow read, delete: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','catatan','oleh','diubah']);
    }
  }
}
