rules_version = '2';
// Firestore Rules Fadzkuruuni. Tempel di Firebase Console > Firestore Database > Rules, lalu Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    // Pemilik: selalu admin dan satu-satunya yang bisa mengubah daftar admin. Samakan dengan ADMIN di admin.html
    function isPemilik() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['hilmykia@gmail.com', 'ponpesfadzkuruuni@gmail.com'];
    }
    // Admin = pemilik + email di dokumen config/admin (diatur dari dashboard > Admin)
    function isAdmin() {
      return isPemilik()
        || (request.auth != null
          && request.auth.token.email_verified == true
          && exists(/databases/$(database)/documents/config/admin)
          && request.auth.token.email.lower() in get(/databases/$(database)/documents/config/admin).data.emails);
    }

    // Kategori akses admin tambahan (config/admin.akses: { email: ['kelas', ...] }):
    //   semua = semua akses; kelas = pengajar Kelas online; laporan = laporan & donasi; tampilan = tampilan aplikasi; statistik = peta & statistik.
    // Admin yang belum diberi kategori (data lama) dianggap "semua". Pemilik selalu semua akses.
    function aksesAdmin() {
      return get(/databases/$(database)/documents/config/admin).data.get('akses', {}).get(request.auth.token.email.lower(), ['semua']);
    }
    function bisa(a) {
      return isPemilik() || (isAdmin() && ('semua' in aksesAdmin() || a in aksesAdmin()));
    }

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Laporan dari halaman "Laporkan masalah": siapa pun boleh mengirim, hanya admin yang bisa membaca dan mengubah.
    // Ukuran dokumen otomatis dibatasi Firestore (maks. 1 MB, termasuk foto).
    // Tata letak aplikasi yang diatur admin: semua orang boleh membaca (aplikasi mengambilnya), hanya admin yang menerbitkan
    match /config/tampilan {
      allow read: if true;
      allow write: if bisa('tampilan');
      match /riwayat/{id} {
        allow read, create: if bisa('tampilan');
      }
    }
    // Daftar admin tambahan: dibaca pengguna yang masuk (untuk Mode admin), diubah hanya oleh pemilik
    match /config/admin {
      allow read: if request.auth != null;
      allow write: if isPemilik();
    }
    // Statistik pemakaian tanpa data pribadi: satu dokumen per hari, aplikasi hanya menambah hitungan; hanya admin yang membaca
    match /stat/{hari} {
      allow read: if bisa('statistik');
      allow create, update: if hari.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['pv', 'aktif', 'hal', 'kota', 'jenis', 'model', 'versi'])
        && request.resource.data.get('hal', {}).size() <= 150
        && request.resource.data.get('kota', {}).size() <= 1000
        && request.resource.data.get('model', {}).size() <= 1000
        && request.resource.data.get('versi', {}).size() <= 200;
    }

    // Kelas online: jadwal & status dibaca semua orang, hanya admin yang membuat / memulai / mengakhiri / menghapus
    match /kelas/{id} {
      allow read: if true;
      allow write: if bisa('kelas');
      // Pesan di kelas: siapa pun yang membuka kelas boleh mengirim pesan pendek; admin boleh menghapus
      match /chat/{pesan} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['nama','teks','t','pid'])
          && request.resource.data.teks is string && request.resource.data.teks.size() > 0 && request.resource.data.teks.size() <= 500
          && request.resource.data.nama is string && request.resource.data.nama.size() <= 40;
        allow delete: if bisa('kelas');
      }
      // Kelas kecil (tanpa LiveKit): daftar hadir & sinyal sambungan suara antar-HP. Data sementara, dihapus saat keluar.
      match /mesh/{doc} {
        allow read: if true;
        allow delete: if true;
        allow create, update: if doc.size() <= 24
          && request.resource.data.keys().hasOnly(['nama','peran','tangan','boleh','t','sdp','host','penuh','bicara','foto','kamera'])
          && request.resource.data.get('foto', '').size() <= 20000
          && request.resource.data.get('sdp', '').size() <= 20000
          && request.resource.data.get('nama', '').size() <= 40
          && (request.resource.data.get('peran', 'jamaah') != 'ustaz' || bisa('kelas'))
          && (doc != 'status' || bisa('kelas'))
          && (!('boleh' in request.resource.data) || bisa('kelas') || (resource != null && request.resource.data.boleh == resource.data.get('boleh', false)));
      }
    }

    // Langganan notifikasi kelas (Web Push di peramban, lihat api/push.js). Satu dokumen per peramban (id = sidik alamat langganan).
    // Siapa pun boleh mendaftarkan / mencabut langganannya; hanya admin yang bisa membaca daftar untuk mengirim notifikasi.
    match /langganan/{id} {
      allow read: if bisa('kelas');
      allow delete: if true;
      allow create, update: if id.size() <= 64
        && request.resource.data.keys().hasOnly(['endpoint', 'p256dh', 'auth', 't'])
        && request.resource.data.endpoint is string && request.resource.data.endpoint.size() <= 1000 && request.resource.data.endpoint.matches('https://.+')
        && request.resource.data.p256dh is string && request.resource.data.p256dh.size() <= 200
        && request.resource.data.auth is string && request.resource.data.auth.size() <= 64;
    }

    match /laporan/{id} {
      allow create: if request.resource.data.keys().hasOnly(['jenis','pesan','lokasi','hal','halJudul','nama','kontak','versi','perangkat','foto','uid','email','status','t'])
        && request.resource.data.pesan is string && request.resource.data.pesan.size() <= 2000
        && request.resource.data.get('status', 'baru') == 'baru'
        && (request.resource.data.get('uid', null) == null || (request.auth != null && request.resource.data.uid == request.auth.uid));
      allow read, delete: if bisa('laporan');
      allow update: if bisa('laporan')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','catatan','oleh','diubah']);
    }
  }
}
